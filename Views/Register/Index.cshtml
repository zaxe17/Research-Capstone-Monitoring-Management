@model monitoring_management.Models.RegisterViewModel

@{
    ViewData["Title"] = "Registration Page";
}

<section class="container vh-100">
    <div class="container h-100">
        <div class="row d-flex justify-content-center align-items-center h-100">
            <div class="col-xl-10">
                <div class="bg-white" style="border-radius: 1rem;">
                    <div class="row g-0">

                        <!-- Left Image -->
                        <div class="col-md-6 col-lg-5 d-none d-md-block">
                            <img src="https://img.magnific.com/free-photo/smiley-men-discussing-eco-project-close-up_23-2148920597.jpg?semt=ais_hybrid&w=740&q=80"
                                 alt="Login Form" class="img-fluid h-100"
                                 style="border-radius: 1rem 0 0 1rem; object-fit: cover;">
                        </div>

                        <!-- Right Form -->
                        <div class="col-md-6 col-lg-7 d-flex align-items-center">
                            <div class="card-body p-4 p-lg-5 text-black">

                                <form asp-controller="Register" asp-action="Index" method="post">
                                    @Html.AntiForgeryToken()

                                    <div class="d-flex align-items-center mb-3">
                                        <span class="h2 fw-bold mb-0">Research & Capstone Monitoring Management</span>
                                    </div>

                                    <h5 class="fw-normal mb-4" style="letter-spacing: 1px;">
                                        Create your account
                                    </h5>

                                    @if (!ViewData.ModelState.IsValid)
                                    {
                                        <div class="alert alert-danger py-2" style="font-size: 13px;">
                                            <div asp-validation-summary="ModelOnly"></div>
                                        </div>
                                    }

                                    <div class="row g-2">
                                        <div class="col-md-6 input-group-sm mb-3">
                                            <label asp-for="StudentNo" class="form-label">Student Number</label>
                                            <input asp-for="StudentNo" class="form-control form-control-lg" style="font-size: 12px;">
                                            <span asp-validation-for="StudentNo" class="text-danger" style="font-size: 11px;"></span>
                                        </div>

                                        <div class="col-md-6 input-group-sm mb-3">
                                            <label asp-for="Email" class="form-label">Email Address</label>
                                            <input asp-for="Email" type="email" class="form-control form-control-lg" style="font-size: 12px;">
                                            <span asp-validation-for="Email" class="text-danger" style="font-size: 11px;"></span>
                                        </div>
                                    </div>

                                    <div class="row g-2">
                                        <div class="col-md-4 input-group-sm mb-3">
                                            <label asp-for="Program" class="form-label">Program</label>
                                            <select asp-for="Program" class="form-select form-select-lg auth-input">
                                                <option value="">Select program</option>

                                                <optgroup label="College of Accountancy and Finance">
                                                    <option value="BSA">BSA</option>
                                                    <option value="BSMA">BSMA</option>
                                                    <option value="BSBAFM">BSBAFM</option>
                                                </optgroup>

                                                <optgroup label="College of Architecture, Design and the Built Environment">
                                                    <option value="BS-ARCH">BS-ARCH</option>
                                                    <option value="BSID">BSID</option>
                                                    <option value="BSEP">BSEP</option>
                                                </optgroup>

                                                <optgroup label="College of Arts and Letters">
                                                    <option value="ABELS">ABELS</option>
                                                    <option value="ABF">ABF</option>
                                                    <option value="ABLCS">ABLCS</option>
                                                    <option value="AB-PHILO">AB-PHILO</option>
                                                    <option value="BPEA">BPEA</option>
                                                </optgroup>

                                                <optgroup label="College of Business Administration">
                                                    <option value="BSBAHRM">BSBAHRM</option>
                                                    <option value="BSBA-MM">BSBA-MM</option>
                                                    <option value="BSENTREP">BSENTREP</option>
                                                    <option value="BSOA">BSOA</option>
                                                </optgroup>

                                                <optgroup label="College of Communication">
                                                    <option value="BADPR">BADPR</option>
                                                    <option value="BA Broadcasting">BA Broadcasting</option>
                                                    <option value="BACR">BACR</option>
                                                    <option value="BAJ">BAJ</option>
                                                </optgroup>

                                                <optgroup label="College of Computer and Information Sciences">
                                                    <option value="BSCS">BSCS</option>
                                                    <option value="BSIT">BSIT</option>
                                                </optgroup>

                                                <optgroup label="College of Education">
                                                    <option value="BTLEd">BTLEd</option>
                                                    <option value="BLIS">BLIS</option>
                                                    <option value="BSEd">BSEd</option>
                                                    <option value="BEEd">BEEd</option>
                                                    <option value="BECEd">BECEd</option>
                                                </optgroup>

                                                <optgroup label="College of Engineering">
                                                    <option value="BSCE">BSCE</option>
                                                    <option value="BSCpE">BSCpE</option>
                                                    <option value="BSEE">BSEE</option>
                                                    <option value="BSECE">BSECE</option>
                                                    <option value="BSIE">BSIE</option>
                                                    <option value="BSME">BSME</option>
                                                    <option value="BSRE">BSRE</option>
                                                </optgroup>

                                                <optgroup label="College of Human Kinetics">
                                                    <option value="BPE">BPE</option>
                                                    <option value="BSESS">BSESS</option>
                                                </optgroup>

                                                <optgroup label="College of Political Science and Public Administration">
                                                    <option value="BPA">BPA</option>
                                                    <option value="BAIS">BAIS</option>
                                                    <option value="BAPE">BAPE</option>
                                                    <option value="BAPS">BAPS</option>
                                                </optgroup>

                                                <optgroup label="College of Social Sciences and Development">
                                                    <option value="ABS">ABS</option>
                                                    <option value="BSE">BSE</option>
                                                    <option value="BAH">BAH</option>
                                                    <option value="BAPHS">BAPHS</option>
                                                    <option value="BSPSY">BSPSY</option>
                                                    <option value="BHS">BHS</option>
                                                    <option value="BSSW">BSSW</option>
                                                </optgroup>

                                                <optgroup label="College of Science">
                                                    <option value="BSFT">BSFT</option>
                                                    <option value="BSAPMATH">BSAPMATH</option>
                                                    <option value="BSBIO">BSBIO</option>
                                                    <option value="BSCHEM">BSCHEM</option>
                                                    <option value="BSMATH">BSMATH</option>
                                                    <option value="BSND">BSND</option>
                                                    <option value="BSPHY">BSPHY</option>
                                                    <option value="BSSTAT">BSSTAT</option>
                                                </optgroup>

                                                <optgroup label="College of Tourism, Hospitality and Transportation Management">
                                                    <option value="BSHM">BSHM</option>
                                                    <option value="BSTM">BSTM</option>
                                                    <option value="BSTRM">BSTRM</option>
                                                </optgroup>
                                            </select>
                                            <span asp-validation-for="Program" class="text-danger auth-error"></span>
                                        </div>
                                    </div>

                                    <div class="row g-2">

                                        <!-- First Name -->
                                        <div class="col-md-4 input-group-sm mb-3">
                                            <label asp-for="FirstName" class="form-label">First Name</label>
                                            <input asp-for="FirstName" class="form-control form-control-lg" style="font-size: 12px;">
                                            <span asp-validation-for="FirstName" class="text-danger" style="font-size: 11px;"></span>
                                        </div>

                                        <!-- Middle Name -->
                                        <div class="col-md-4 input-group-sm mb-3">
                                            <label asp-for="MiddleName" class="form-label">Middle Name</label>
                                            <input asp-for="MiddleName" class="form-control form-control-lg" style="font-size: 12px;">
                                        </div>

                                        <!-- Last Name -->
                                        <div class="col-md-4 input-group-sm mb-3">
                                            <label asp-for="LastName" class="form-label">Last Name</label>
                                            <input asp-for="LastName" class="form-control form-control-lg" style="font-size: 12px;">
                                            <span asp-validation-for="LastName" class="text-danger" style="font-size: 11px;"></span>
                                        </div>

                                    </div>

                                    <div class="input-group-sm mb-3">
                                        <label asp-for="Password" class="form-label">Password</label>
                                        <input asp-for="Password" class="form-control form-control-lg" style="font-size: 12px;">
                                        <span asp-validation-for="Password" class="text-danger" style="font-size: 11px;"></span>
                                    </div>

                                    <div class="input-group-sm mb-4">
                                        <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                                        <input asp-for="ConfirmPassword" class="form-control form-control-lg" style="font-size: 12px;">
                                        <span asp-validation-for="ConfirmPassword" class="text-danger" style="font-size: 11px;"></span>
                                    </div>

                                    <div class="d-grid mb-3">
                                        <button class="btn btn-dark btn-lg" type="submit">
                                            Sign Up
                                        </button>
                                    </div>

                                    <p class="mt-4 mb-2">
                                        Already have an account?
                                        <a asp-controller="Login" asp-action="Index">Sign In</a>
                                    </p>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>