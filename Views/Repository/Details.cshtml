@using monitoring_management.Models
@model ResearchPaper

@{
    ViewData["Title"] = "Research details";
    var keywordList = string.IsNullOrWhiteSpace(Model.Keywords)
        ? new List<string>()
        : Model.Keywords.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries).ToList();
    var backUrl = !string.IsNullOrWhiteSpace(ViewBag.ReturnUrl as string)
        ? (string)ViewBag.ReturnUrl
        : Url.Action("Index", "Repository");
}

<div class="d-flex w-100 h-100">
    <partial name="_Sidebar" model="ViewBag.Sidebar" />
    <main class="flex-grow-1" style="padding: 30px;">

        <div class="mb-3">
            <a class="btn ghost sm" style="display:inline-flex; align-items:center; gap:6px; width:fit-content;"
               href="@backUrl">
                <span aria-hidden="true">&larr;</span> Back to repository
            </a>
        </div>

        <div class="row g-3">
            <div class="col-lg-7">
                <div class="card">
                    <div class="d-flex align-items-center gap-3" style="margin-bottom:14px;">
                        <span class="cat-pill">@(Model.Category?.CategoryName ?? "Uncategorized")</span>
                        <span class="badge approved py-2">@Model.Status.ToString().ToUpper()</span>
                    </div>

                    <div class="pb-3 mb-3" style="border-bottom: 1px solid var(--line);">
                        <p class="fw-bold mb-2" style="font-family:var(--font-display); font-size:24px; margin:12px 0 6px; color:var(--maroon-800);">
                            @Model.Title
                        </p>

                        <div class="small-text">
                            <span>Paper ID: @Model.PaperId</span> •
                            <span>Uploaded @Model.DateUploaded.ToString("MMMM d, yyyy")</span> •
                            <span>Year @Model.Year</span>
                        </div>
                    </div>

                    <div class="pb-3 mb-3" style="border-bottom: 1px solid var(--line);">
                        <h3 style="font-size:14px; font-weight:600; margin-bottom:8px;">Abstract</h3>
                        <p class="fw-lighter m-0" style="font-size:14px; color:var(--ink-900);">
                            @Model.Description
                        </p>
                    </div>

                    @if (keywordList.Count > 0)
                    {
                        <div class="">
                            <h3 style="font-size:14px; font-weight:600; margin-bottom:8px;">Keywords</h3>
                            <div class="d-flex flex-wrap justify-content-start align-items-center">
                                @foreach (var kw in keywordList)
                                {
                                    <div class="tag keywords">@kw</div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="col-lg-5">
                <div class="d-flex flex-column gap-3">
                    <div class="card">
                        <h3 style="font-size:14px; font-weight:600; margin-bottom:14px;">Research members</h3>

                        <div>
                            @foreach (var member in Model.ResearchMembers.OrderBy(m => m.Role))
                            {
                                <partial name="_Member_card" model="member" />
                            }
                        </div>
                    </div>

                    <div class="card">
                        <h3 style="font-size:14px; font-weight:600; margin-bottom:14px;">Submission info</h3>

                        <table>
                            <tr>
                                <td style="padding:6px 0; color:var(--ink-600);">College</td>
                                <td style="padding:6px 0; text-align:right;">CCIS</td>
                            </tr>
                            <tr>
                                <td style="padding:6px 0; color:var(--ink-600);">Status</td>
                                <td style="padding:6px 0; text-align:right;">@Model.Status</td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>