<div class="mb-4">
    <span class="fw-bold text-uppercase"
          style="color: var(--gold-700); letter-spacing: .14em; font-size: 11px;">
        @ViewData["TabName"]
    </span>

    <h1 class="fw-semibold"
        style="color: var(--maroon-800); font-family: var(--font-display); font-size: 28px;">
        @ViewData["Content"]
    </h1>

    <p style="color: var(--ink-600); font-size: 14px;">
        @ViewData["Description"]
    </p>
</div>