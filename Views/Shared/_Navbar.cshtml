@{
    var role = Context.Session.GetString("Role");
    var fullName = Context.Session.GetString("FullName") ?? "Guest";

    string? subLabel = null;
    if (role == "Admin")
    {
        subLabel = "Administrator";
    }
    else if (!string.IsNullOrEmpty(role))
    {
        var program = Context.Session.GetString("Program");
        var studentNo = Context.Session.GetString("StudentNo");
        if (!string.IsNullOrEmpty(program) || !string.IsNullOrEmpty(studentNo))
        {
            subLabel = $"{program} · {studentNo}";
        }
    }

    var nameParts = fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var initials = nameParts.Length >= 2
        ? $"{nameParts[0][0]}{nameParts[^1][0]}".ToUpper()
        : (nameParts.Length == 1 ? fullName.Substring(0, Math.Min(2, fullName.Length)).ToUpper() : "??");
}

<nav class="navbar navbar-expand-lg navbar-dark"
     style="background: #560a1b; border-bottom:3px solid var(--gold-600); padding: 0 28px; height: 64px;">
    <div class="container-fluid">

        <!-- Brand -->
        <a class="navbar-brand d-flex align-items-center gap-3" href="#">
            <div class="rounded-circle border border-warning d-flex align-items-center justify-content-center"
                 style="width:38px;height:38px;">
                <svg width="28" height="28" viewBox="0 0 24 24">
                    <path d="M12 1 L15 9 L23 9 L16.5 14 L19 22 L12 17 L5 22 L7.5 14 L1 9 L9 9 Z" fill="var(--gold-600)" />
                </svg>
            </div>

            <div>
                <div class="text-uppercase fw-semibold text-warning" style="font-size: 11px; letter-spacing: .12em;">
                    Polytechnic University of the Philippines
                </div>
                <div class="fs-5 fw-semibold text-white" style="font-family: var(--font-display); letter-spacing: .01em">
                    Research & Capstone Monitoring Management
                </div>
            </div>
        </a>

        <!-- Mobile Toggle -->
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Right Side -->

        <!-- User -->
        <div class="d-flex align-items-center text-white" style="font-size: 13px; gap: 10px;">
            <div class="rounded-circle bg-warning text-dark fw-bold d-flex align-items-center justify-content-center"
                 style="width:32px;height:32px;">
                @initials
            </div>

            <div>
                <div class="fw-semibold">@fullName</div>
                @if (!string.IsNullOrEmpty(subLabel))
                {
                    <small class="text-light opacity-75" style="font-size: 10px;">
                        @subLabel
                    </small>
                }
            </div>
        </div>


    </div>
</nav>