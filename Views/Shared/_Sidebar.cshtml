@model List<monitoring_management.Models.SidebarModel>

<div class="d-flex flex-column flex-shrink-0 p-3 pt-4 text-white h-100"
     style="background: var(--maroon-900); width: 230px;">
    <div class="d-flex align-items-center mb-3 mb-md-0 me-md-auto text-white text-decoration-none">
        <span class="text-uppercase fw-bold p-2"
              style="color: var(--gold-500); font-size: 11px; letter-spacing: .12em;">Student module</span>
    </div>
    <hr>
    <ul class="nav nav-pills flex-column mb-auto gap-1">
        @foreach (var item in Model ?? new List<SidebarModel>())
        {
            <li class="nav-item">
                <a asp-controller="@item.Folder" asp-action="@item.Action" class="nav-link ps-4 tab-hover" style="font-size: 14px" aria-current="page">
                    @item.Title
                </a>
            </li>
        }
    </ul>

    @{
        string? role = ViewBag.CurrentPaperRole as string;
        string? title = ViewBag.CurrentPaperTitle as string;
    }
    @if (!string.IsNullOrEmpty(role) && !string.IsNullOrEmpty(title))
    {
        var truncated = title.Length > 28 ? title.Substring(0, 28) + "..." : title;
        <div class="pt-3 mt-3" style="border-top: 1px solid rgba(255,255,255,0.15); font-size: 11px; opacity: 0.85; line-height: 1.4;">
            Logged in as <strong>@role</strong> of<br>"@truncated"
        </div>
    }
</div>