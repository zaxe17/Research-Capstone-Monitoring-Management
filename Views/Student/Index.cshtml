@{
    ViewData["Title"] = "Student Page";
    int currentPage = (int)ViewBag.CurrentPage;
    int totalPages = (int)ViewBag.TotalPages;
}

<div class="d-flex w-100 h-100">
    <partial name="_Sidebar" model="ViewBag.Sidebar" />
    <main class="flex-grow-1" style="padding: 30px;">
        <!-- Header -->
        <partial name="_Header_page" view-data='new ViewDataDictionary(ViewData)
                 {
                     ["TabName"] = "Repository",
                     ["Content"] = "Browse approved research",
                     ["Description"] = "Check if a capstone topic already exists before drafting your proposal."
                 }' />

        <!-- Search bar -->
        <partial name="_Searchbar" />

        <!-- Table -->
        <div class="card" style="padding: 0;">
            <table style="font-size: 13px;">
                <thead>
                    <tr>
                        <th style="font-size: 10px; color: var(--ink-600);">TITLE</th>
                        <th style="font-size: 10px; color: var(--ink-600);">CATEGORY</th>
                        <th style="font-size: 10px; color: var(--ink-600);">YEAR</th>
                        <th style="font-size: 10px; color: var(--ink-600);">UPLOADED BY</th>
                        <th style="font-size: 10px; color: var(--ink-600);">STATUS</th>
                        <th style="font-size: 10px; color: var(--ink-600);"></th>
                    </tr>
                </thead>

                <tbody>
                    @if (ViewBag.Papers.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center small-text py-4">No approved papers found.</td>
                        </tr>
                    }
                    @foreach (var paper in ViewBag.Papers)
                    {
                        <tr>
                            <td>
                                <div class="title-cell">
                                    @paper.Title
                                </div>
                            </td>

                            <td>
                                <span class="cat-pill">
                                    @(paper.Category?.CategoryName ?? "Uncategorized")
                                </span>
                            </td>

                            <td>
                                @paper.Year
                            </td>

                            <td>
                                @paper.Student?.FullName
                            </td>

                            <td>
                                <span class="badge approved py-2">
                                    <i class="ti ti-check"></i> @paper.Status
                                </span>
                            </td>

                            <td>
                                <a asp-action="Details" asp-controller="Repository" asp-route-id="@paper.PaperId"
                                   class="btn ghost sm" style="font-size: 12px;">
                                    View
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (totalPages > 1)
        {
            <nav class="mt-3">
                <ul class="pagination justify-content-end">
                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-controller="Student" asp-route-page="@(currentPage - 1)">Previous</a>
                    </li>

                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-controller="Student" asp-route-page="@i">@i</a>
                        </li>
                    }

                    <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-controller="Student" asp-route-page="@(currentPage + 1)">Next</a>
                    </li>
                </ul>
            </nav>
        }
    </main>
</div>